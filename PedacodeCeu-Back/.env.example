# DB_HOST e DB_PORT são definidos pelo docker-compose
DB_NAME=pedacodoceu
DB_USER=pedaco
DB_PASS=troque-esta-senha

# Use 32 caracteres ou mais. Precisa ser IGUAL ao de PedacodeCeu-Avaliacoes/.env
JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais

# Token das rotas internas (serviço -> serviço). Precisa ser IGUAL ao de PedacodeCeu-Avaliacoes/.env
INTERNAL_TOKEN=troque-por-um-token-interno

CACHE_TTL=60
