# Banco próprio do serviço (o container do PostgreSQL usa estas mesmas variáveis)
POSTGRES_USER=avaliacoes
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=avaliacoes

# Precisa ser IGUAL ao JWT_SECRET de PedacodeCeu-Back/.env (é o mesmo token do login)
# Use 32 caracteres ou mais.
JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais

# Precisa ser IGUAL ao INTERNAL_TOKEN de PedacodeCeu-Back/.env
INTERNAL_TOKEN=troque-por-um-token-interno

# Opcionais (valores padrão)
CACHE_TTL=60
LOG_LEVEL=INFO
HTTP_TIMEOUT=2.0
HTTP_TENTATIVAS=3
CB_LIMITE_FALHAS=3
CB_TEMPO_RESET=30
